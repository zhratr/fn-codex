#!/bin/sh
set -eu

APP_NAME="fn-codex"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
SCRIPT_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd -P)"
APPDEST="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
PKGHOME="${TRIM_PKGHOME:-${TRIM_APPHOME:-/usr/local/apps/@apphome/${APP_NAME}}}"
PKGVAR="${TRIM_PKGVAR:-${TRIM_APPDATA:-/usr/local/apps/@appdata/${APP_NAME}}}"

CONTENT_ROOT=""
for candidate in "${TRIM_APPDEST:-}" "${APPDEST}" "${APPDEST}/target" "${SCRIPT_ROOT}" "${SCRIPT_ROOT}/target" \
  "/usr/local/apps/@appcenter/${APP_NAME}" "/usr/local/apps/@appcenter/${APP_NAME}/target"; do
  [ -n "${candidate}" ] || continue
  if [ -x "${candidate}/runtime/node" ] && [ -f "${candidate}/server/server.js" ]; then
    CONTENT_ROOT="${candidate}"
    break
  fi
done
NODE_BIN="${CONTENT_ROOT:-${APPDEST}}/runtime/node"
SERVER="${CONTENT_ROOT:-${APPDEST}}/server/server.js"

APP_HOME="${PKGHOME}"
APP_DATA="${PKGVAR}"
VAR_DIR="${PKGVAR}"
PID_FILE="${VAR_DIR}/${APP_NAME}.pid"
if [ -n "${TRIM_PKGLOG:-}" ]; then
  LOG_FILE="${TRIM_PKGLOG}"
elif [ -d "/var/log/apps" ]; then
  LOG_FILE="/var/log/apps/${APP_NAME}.log"
else
  LOG_FILE="${VAR_DIR}/${APP_NAME}.log"
fi

mkdir -p "${VAR_DIR}"

log_lifecycle() {
  printf '%s fn-codex lifecycle: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"${LOG_FILE}"
}

is_running() {
  [ -s "${PID_FILE}" ] || return 1
  pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
  case "${pid}" in
    ''|*[!0-9]*)
      log_lifecycle "removed invalid stale PID file"
      rm -f "${PID_FILE}"
      return 1
      ;;
  esac
  if ! kill -0 "${pid}" 2>/dev/null || [ ! -r "/proc/${pid}/cmdline" ]; then
    log_lifecycle "removed stale PID ${pid}: process or proc entry unavailable"
    rm -f "${PID_FILE}"
    return 1
  fi

  cmdline="$(tr '\000' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
  case "${cmdline}" in
    *"${SERVER}"*) return 0 ;;
  esac

  log_lifecycle "removed stale PID ${pid}: command does not match ${SERVER}"
  rm -f "${PID_FILE}"
  return 1
}

start_service() {
  if is_running; then
    log_lifecycle "start skipped: already running pid=$(cat "${PID_FILE}")"
    return 0
  fi
  if [ ! -x "${NODE_BIN}" ] || [ ! -f "${SERVER}" ]; then
    log_lifecycle "start failed: runtime=${NODE_BIN} server=${SERVER}"
    echo "fn-codex runtime is incomplete: ${NODE_BIN}" >&2
    exit 1
  fi
  export FN_CODEX_BIND="${FN_CODEX_BIND:-0.0.0.0}"
  export FN_CODEX_PORT="${FN_CODEX_PORT:-3010}"
  export FN_CODEX_WORKSPACE="${FN_CODEX_WORKSPACE:-${APP_HOME}/workspace}"
  export FN_CODEX_STATE_DIR="${FN_CODEX_STATE_DIR:-${APP_DATA}/state}"
  export FN_CODEX_ALLOW_COMMANDS="${FN_CODEX_ALLOW_COMMANDS:-0}"
  export CODEX_API_URL="${CODEX_API_URL:-}"
  export CODEX_API_KEY="${CODEX_API_KEY:-}"
  export CODEX_MODEL="${CODEX_MODEL:-}"
  log_lifecycle "start requested: bind=${FN_CODEX_BIND} port=${FN_CODEX_PORT} server=${SERVER}"
  nohup "${NODE_BIN}" "${SERVER}" >>"${LOG_FILE}" 2>&1 &
  pid="$!"
  echo "${pid}" >"${PID_FILE}"
  log_lifecycle "start launched pid=${pid}"
}

stop_service() {
  if is_running; then
    pid="$(cat "${PID_FILE}")"
    log_lifecycle "stop requested pid=${pid}"
    kill "${pid}" 2>/dev/null || true
    for _ in 1 2 3 4 5; do is_running || break; sleep 1; done
    log_lifecycle "stop complete"
  else
    log_lifecycle "stop requested: already stopped"
  fi
  rm -f "${PID_FILE}"
}

ACTION="${1:-start}"
case "${ACTION}" in
  start) start_service ;;
  stop) stop_service ;;
  restart) stop_service; start_service ;;
  status) if is_running; then echo "running ($(cat "${PID_FILE}"))"; else echo "stopped"; fi ;;
  log) touch "${LOG_FILE}"; tail -n 100 "${LOG_FILE}" ;;
  *) echo "usage: $0 {start|stop|restart|status|log}" >&2; exit 2 ;;
esac
