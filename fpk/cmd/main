#!/bin/sh
set -eu

APPDEST="${TRIM_APPDEST:?TRIM_APPDEST is required}"
VAR_DIR="${TRIM_PKGVAR:-${APPDEST}/var}"
PID_FILE="${VAR_DIR}/fn-codex.pid"
LOG_FILE="${VAR_DIR}/fn-codex.log"
CONTENT_ROOT="${APPDEST}"
if [ -d "${APPDEST}/target" ]; then CONTENT_ROOT="${APPDEST}/target"; fi
NODE_BIN="${CONTENT_ROOT}/runtime/node"
SERVER="${CONTENT_ROOT}/server/server.js"

mkdir -p "${VAR_DIR}"

log_lifecycle() {
  printf '%s fn-codex lifecycle: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"${LOG_FILE}"
}

is_running() {
  [ -s "${PID_FILE}" ] || return 1
  pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
  case "${pid}" in
    ''|*[!0-9]*)
      log_lifecycle "removed invalid stale PID file"
      rm -f "${PID_FILE}"
      return 1
      ;;
  esac
  if ! kill -0 "${pid}" 2>/dev/null || [ ! -r "/proc/${pid}/cmdline" ]; then
    log_lifecycle "removed stale PID ${pid}: process or proc entry unavailable"
    rm -f "${PID_FILE}"
    return 1
  fi

  cmdline="$(tr '\000' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
  case "${cmdline}" in
    *"${SERVER}"*) return 0 ;;
  esac

  log_lifecycle "removed stale PID ${pid}: command does not match ${SERVER}"
  rm -f "${PID_FILE}"
  return 1
}

start_service() {
  if is_running; then
    log_lifecycle "start skipped: already running pid=$(cat "${PID_FILE}")"
    return 0
  fi
  if [ ! -x "${NODE_BIN}" ] || [ ! -f "${SERVER}" ]; then
    log_lifecycle "start failed: runtime=${NODE_BIN} server=${SERVER}"
    echo "fn-codex runtime is incomplete: ${NODE_BIN}" >&2
    exit 1
  fi
  export FN_CODEX_BIND="${FN_CODEX_BIND:-0.0.0.0}"
  export FN_CODEX_PORT="${FN_CODEX_PORT:-3010}"
  export FN_CODEX_WORKSPACE="${FN_CODEX_WORKSPACE:-${TRIM_APPHOME:-${APPDEST}/home}/workspace}"
  export FN_CODEX_STATE_DIR="${FN_CODEX_STATE_DIR:-${TRIM_APPDATA:-${APPDEST}/var}/state}"
  export FN_CODEX_ALLOW_COMMANDS="${FN_CODEX_ALLOW_COMMANDS:-0}"
  export CODEX_API_URL="${CODEX_API_URL:-}"
  export CODEX_API_KEY="${CODEX_API_KEY:-}"
  export CODEX_MODEL="${CODEX_MODEL:-}"
  log_lifecycle "start requested: bind=${FN_CODEX_BIND} port=${FN_CODEX_PORT} server=${SERVER}"
  nohup "${NODE_BIN}" "${SERVER}" >>"${LOG_FILE}" 2>&1 &
  pid="$!"
  echo "${pid}" >"${PID_FILE}"
  log_lifecycle "start launched pid=${pid}"
}

stop_service() {
  if is_running; then
    pid="$(cat "${PID_FILE}")"
    log_lifecycle "stop requested pid=${pid}"
    kill "${pid}" 2>/dev/null || true
    for _ in 1 2 3 4 5; do is_running || break; sleep 1; done
    log_lifecycle "stop complete"
  else
    log_lifecycle "stop requested: already stopped"
  fi
  rm -f "${PID_FILE}"
}

ACTION="${1:-start}"
case "${ACTION}" in
  start) start_service ;;
  stop) stop_service ;;
  restart) stop_service; start_service ;;
  status) if is_running; then echo "running ($(cat "${PID_FILE}"))"; else echo "stopped"; fi ;;
  log) touch "${LOG_FILE}"; tail -n 100 "${LOG_FILE}" ;;
  *) echo "usage: $0 {start|stop|restart|status|log}" >&2; exit 2 ;;
esac
